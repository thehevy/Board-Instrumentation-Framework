<ExternalMinionFile>
	<DynamicCollector Prefix="post.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="1000">
		<File>testdata/test_results_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>
	<DynamicCollector Prefix="post.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="5000">
		<File>testdata/test_ethtool_stats_results_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>
	<DynamicCollector Prefix="post.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="1000">
		<File>testdata/test_total_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>

	<DynamicCollector  Prefix="previous.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="1000">
		<File>previous_run/test_results_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>
	<DynamicCollector Prefix="previous.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="1000">
		<File>previous_run/test_ethtool_stats_results_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>
	<DynamicCollector Prefix="previous.$(PORT_NUM)." DoNotSend="False" OnlySendOnChange="False" Frequency="1000">
		<File>previous_run/test_total_$(PORT_NUM).txt</File>
		<Precision>0</Precision>
	</DynamicCollector>
</ExternalMinionFile>
