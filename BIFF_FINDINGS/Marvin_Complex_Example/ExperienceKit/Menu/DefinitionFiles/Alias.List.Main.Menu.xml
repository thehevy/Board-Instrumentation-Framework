<MarvinExternalFile>
	<AliasList>
		<Import>$(AppDir)\Menu\DefinitionFiles\Alias.List.Icons.xml</Import>
		<!-- NUMBER OF MENU BUTTONS -->
		<Alias Main.Menu.Button.Count="4"/>
		
		<!-- MAIN MENU BUTTON TEXT -->
		<Alias Main.Menu.Button.1.Text="Home"/>
		<Alias Main.Menu.Button.2.Text="Information Area"/>
		<Alias Main.Menu.Button.3.Text="Intel Ethernet E830 Demo"/>
		<Alias Main.Menu.Button.4.Text="Legal"/>
<!-- 
		MENU BUTTON TYPES
		Link - Will open up default browser to defined weblink
		SubMenu - Expanding Menu system for slide decks (Shows only .png files)
		Fixed - Series of Buttons that don't change state (Single Action for each button in Menu). Names can change
		Toggle - Series of Buttons that change state (on / off actions) - WIP
		Dynamic - Series of Buttons that change state, and show/hide next option (show/hide/toggle)
		
-->
		<Alias Main.Menu.Button.2.Type="SubMenu"/>
		<Alias Main.Menu.Button.3.Type="Fixed"/>
		<Alias Main.Menu.Button.4.Type="Link"/>	
<!-- 
		MENU IDs
		Each Button type, other than Link, requires a unique ID, button count and an alias file 
-->
		<Alias Main.Menu.Button.1.MID="Main"/>
		<Alias Main.Menu.Button.2.MID="Info"/>
		<Alias Main.Menu.Button.3.MID="Demo.E830"/>
		<Alias Main.Menu.Button.4.MID="Legal"/>	
		
		<!-- Button Count for Each Menu. Alias format is $(MID).Menu.Button.Count -->
		<Alias Info.Menu.Button.Count="1"/>
		<Alias Demo.E830.Menu.Button.Count="4"/>
		<!-- <Alias Legal.Menu.Button.Count="1"/> -->
		
		<!-- Links for Buttons defined -->
		<Alias Main.Menu.Button.4.Link="www.intel.com/ethernet"/>
		
		
		<!-- Alias files for each MID
		Format: Path\Alias.List.$MID.menu.xml  
		Example:  <Import>$(AppDir)\Menu\DefinitionFiles\Alias.List.Info.Menu.xml</Import>
		-->
		<Import>$(AppDir)\Menu\DefinitionFiles\Alias.List.Info.Menu.xml</Import>
		<Import>$(AppDir)\Menu\DefinitionFiles\Alias.List.Demo.E830.Menu.xml</Import>

<!-- 		
		By default, the first task will run when expanding the menus.
		Create exception to not run task on menu expansion.
		Example: <Alias Run.Demo.DDP.Menu.Button.1.Task="No"/>
-->
		<Alias Run.Demo.E830.Menu.Button.1.Task="No"/>

<!-- 
		MENU BUTTON ICONS 
		Each Main.Menu.Button needs an Icon. Below are a list of approved Icons:
		Home
		Information
		Gauge
		Legal
		Mail
		Link
		ExternalLink
		Expert
		Network
-->
		<Alias Main.Menu.Button.1.Icon="Home"/>
		<Alias Main.Menu.Button.2.Icon="Information"/>
		<Alias Main.Menu.Button.3.Icon="Gauge"/>
		<Alias Main.Menu.Button.4.Icon="Legal"/>

		<!-- The following options should not be changed. The adhere to the Intel Style Guide for UI -->
		<Alias Button.Text.Size="0.8em"/>
		<Alias Button.Text.Font="$(Intel_Font)"/>
		<!-- Menu Sizes -->
		<Alias Menu.Button.Width="280"/>
		<Alias Menu.Button.Height="40"/>
		<Alias Menu.Width="MarvinMath($(Menu.Button.Width),+,4)"/>
		<Alias Menu.Height="MarvinMath(MarvinMath($(Menu.Button.Height),*,$(Main.Menu.Button.Count)),+,14)"/>
		<!-- Menu Icon Sizes -->
		<Alias Icon.Size="20"/><!-- MarvinMath($(Menu.Button.Height),div,2) -->
		<Alias More.Size="10"/><!-- MarvinMath($(Menu.Button.Height),div,4) -->
	
		<DefaultAlias ICON_SIZE="10"/>
		<DefaultAlias ICON_NAMESPACE="NA"/>
		<DefaultAlias ICON_ID="NA"/>
		<DefaultAlias ICON_PEEKABOO_NAMESPACE="NA"/>
		<DefaultAlias ICON_PEEKABOO_ID="NA"/>
		<DefaultAlias MORE="no"/>
		<DefaultAlias ICON="blank"/>
		<For Count="20" StartValue="0">
			<DefaultAlias Main.Menu.Button.REPLACE.MID="Main.Menu" REPLACE="$(CurrentValueAlias)"/>
		</For>
		<For Count="20" StartValue="0">
			<DefaultAlias Main.Menu.Button.REPLACE.Type="Button" REPLACE="$(CurrentValueAlias)"/>
		</For>
	</AliasList>
</MarvinExternalFile>	
