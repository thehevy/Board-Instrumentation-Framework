##############################################################################
#    File Abstract: Info Menu, and Info Submenu Button Names
#	 Called by: Alias.List.Main.Menu
#
#	HOW TO USE THIS ALIAS LIST
#	
#	Alias List Name is defined in the $(AppDir)\Menu\DefinitionFiles\Alias.List.Main.Menu.xml file as MID
#	Number of Main Buttons to be created is defined in the $(AppDir)\Menu\DefinitionFiles\Alias.List.Main.Menu.xml file as MID.Menu.Button.Count
#	For the number of Main Buttons that is defined, they will need the following definition: 
#	Text to be displayed: MID.Menu.Button.#.Text=
#	A Submenu Button List Button Count: MID.Menu.Submenu.#.Button.Count=
#	Each Submenu Button will need Text to be displayed: MID.Menu.Submenu.1.Button.1.Text=
#	Each Submenu Button that is defined, needs a corresponding .png file located in the corresponding folder. $(AppDir)\InformationArea\MID.Submenu#\#.png
#	For ease of use, make a copy of this file, and do a find/replace all for the default MID of Info
#
#	Example of all Alias' and file formats using EXAMPLE, as the MID
#	<Alias EXAMPLE.Menu.Button.Count="2"/> defined in $(AppDir)\Menu\DefinitionFiles\Alias.List.Main.Menu.xml
#
#	<Alias EXAMPLE.Menu.Button.1.Text="Example Button Number 1"/>
#	<Alias EXAMPLE.Menu.Button.2.Text="Example Button Number 2"/>
#
#	<Alias EXAMPLE.Menu.Submenu.1.Button.Count="2"/>
#	<Alias EXAMPLE.Menu.Submenu.1.Button.1.Text="Submenu 1 button 1"/> with Image file 1.png in folder $(AppDir)\InformationArea\EXAMPLE.1\1.png
#	<Alias EXAMPLE.Menu.Submenu.1.Button.2.Text="Submenu 1 button 2/>  with Image file 2.png in folder $(AppDir)\InformationArea\EXAMPLE.1\2.png
#
#	<Alias EXAMPLE.Menu.Submenu.2.Button.Count="1"/>
#	<Alias EXAMPLE.Menu.Submenu.2.Button.1.Text="Submenu 2 button 1"/> with Image file 1.png in folder $(AppDir)\InformationArea\EXAMPLE.2\1.png
#
#	File Type can also be changed for each button. Defailt file Type is Image (.png files)
#	Current Options are: Image ; Grid
#	Only add this definition, if changing from a Image
#	<Alias Example.Menu.Submenu.1.Button.1.Type="Grid"/>
#
##############################################################################
-->
