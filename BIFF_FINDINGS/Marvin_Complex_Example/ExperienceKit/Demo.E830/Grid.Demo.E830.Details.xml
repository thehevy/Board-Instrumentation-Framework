	<TaskList ID="Show.$(task_prefix)_DYN_LEFT_TOP.FLIP.1">
		<TaskItem Type="Marvin">
			<DataToInsert Namespace="$(task_prefix)_DYN_LEFT_TOP.PANEL" ID="$(task_prefix)_DYN_LEFT_TOP.FLIP" Data="$(task_prefix)_DYN_LEFT_TOP.FLIP.2"/>
		</TaskItem>
	</TaskList>

