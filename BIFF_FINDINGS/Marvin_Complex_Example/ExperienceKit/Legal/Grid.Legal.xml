<MarvinExternalFile>
<Grid>
		<Grid row="$(CurrentRowAlias)"
		        column="$(CurrentColumnAlias)"
		        width="95%g"
		        height="95%g">
			<StyleOverride>
				<Item>-fx-background-color: white;</Item>
			</StyleOverride>
			<Widget File="Image\ImageScale.xml"
					row="$(CurrentRowAlias)"
					column="$(CurrentColumnAlias)"
					width="100%g"
					height="100%g">
				<Source>$(AppDir)/Legal/LegalNoticesAndDisclaimers.png</Source>
			</Widget>
		</Grid>
	</Grid>
</MarvinExternalFile>	