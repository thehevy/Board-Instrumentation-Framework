<MarvinExternalFile>

	<Tab>
		<Grid row="0"
		      column="0">
		</Grid>
	</Tab>

		<TaskList ID="Startup.Tasks" PerformOnStartup="true">
			<TaskItem Type="OtherTask" ID="Tab.ExperienceKit.Reset.Menu.Buttons"/>

		<TaskItem Type="MarvinAdmin" Postpone="50">
			<Task ID="SetActiveTab"
			      Data="Tab.ExperienceKit"/>
			<Task ID="SetTabVisibility" Data="Tab.Splash:False"/>
		</TaskItem>
	</TaskList>








</MarvinExternalFile>