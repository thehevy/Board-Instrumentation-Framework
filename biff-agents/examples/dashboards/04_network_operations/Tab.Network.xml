<MarvinExternalFile>
    <Tab>
        <Title>$(MinionNamespace) - Network Performance</Title>

        <Grid columns="4" hgap="$(GridHGap)" vgap="$(GridVGap)">

            <Widget File="Chart/LineChart.xml" row="0" column="0" rowSpan="2" columnSpan="4" Height="$(ChartHeight)">
                <Title>$(Interface1) Bandwidth</Title>
                <xAxisLabel>Time</xAxisLabel>
                <HistorySize>100</HistorySize>
                <yAxisLabel>Value</yAxisLabel>
                <ShowLegend>true</ShowLegend>
                <Series>
                    <SeriesSet>
                        <Title>Interface $(Interface1) Bandwidth</Title>
                        <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.bandwidth"/>
                        <Color>#0000FF</Color>
                    </SeriesSet>
                </Series>
            </Widget>

            <Widget File="Chart/LineChart.xml" row="2" column="0" rowSpan="2" columnSpan="4" Height="$(ChartHeight)">
                <Title>$(Interface1) Packets RX</Title>
                <xAxisLabel>Time</xAxisLabel>
                <HistorySize>100</HistorySize>
                <yAxisLabel>Value</yAxisLabel>
                <ShowLegend>true</ShowLegend>
                <Series>
                    <SeriesSet>
                        <Title>Interface $(Interface1) Packets_Rx</Title>
                        <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.packets_rx"/>
                        <Color>#0000FF</Color>
                    </SeriesSet>
                </Series>
            </Widget>

            <Widget File="Chart/LineChart.xml" row="4" column="0" rowSpan="2" columnSpan="4" Height="$(ChartHeight)">
                <Title>$(Interface1) Packets TX</Title>
                <xAxisLabel>Time</xAxisLabel>
                <HistorySize>100</HistorySize>
                <yAxisLabel>Value</yAxisLabel>
                <ShowLegend>true</ShowLegend>
                <Series>
                    <SeriesSet>
                        <Title>Interface $(Interface1) Packets_Tx</Title>
                        <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.packets_tx"/>
                        <Color>#0000FF</Color>
                    </SeriesSet>
                </Series>
            </Widget>

            <Widget File="LED/LED.xml" row="6" column="0" Height="24" Width="24">
                <Title>interface.eth0.bandwidth</Title>
                <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.bandwidth"/>
                <OnCondition>>$(BandwidthThreshold)</OnCondition>
                <Color>Green</Color>
            </Widget>

            <Widget File="LED/LED.xml" row="6" column="1" Height="24" Width="24">
                <Title>interface.eth0.packets_rx</Title>
                <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.packets_rx"/>
                <OnCondition>>$(PacketThreshold)</OnCondition>
                <Color>Green</Color>
            </Widget>

            <Widget File="LED/LED.xml" row="6" column="2" Height="24" Width="24">
                <Title>interface.eth0.packets_tx</Title>
                <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.packets_tx"/>
                <OnCondition>>$(PacketThreshold)</OnCondition>
                <Color>Green</Color>
            </Widget>

            <Widget File="LED/LED.xml" row="6" column="3" Height="24" Width="24">
                <Title>interface.eth0.errors</Title>
                <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.errors"/>
                <OnCondition>>$(BandwidthThreshold)</OnCondition>
                <Color>Green</Color>
            </Widget>

            <Widget File="LED/LED.xml" row="7" column="0" Height="24" Width="24">
                <Title>interface.eth0.drops</Title>
                <MinionSrc Namespace="$(MinionNamespace)" ID="interface.eth0.drops"/>
                <OnCondition>>$(BandwidthThreshold)</OnCondition>
                <Color>Green</Color>
            </Widget>

        </Grid>
    </Tab>
</MarvinExternalFile>
