<?xml version="1.0" encoding="UTF-8"?>
<!-- Example 1: Server Monitoring Configuration -->
<Minion>
    <AliasList>
        <!-- Import alias definitions -->
        <Import>DefinitionFiles/01_server_monitoring_aliases.xml</Import>
    </AliasList>
    
    <Namespace>
        <Name>$(MinionNamespace)</Name>
        <DefaultFrequency>$(DefaultFrequency)</DefaultFrequency>
        
        <!-- CPU Metrics -->
        <Collector ID="cpu.usage" Frequency="$(FastFrequency)">
            <Executable>$(CollectorsPath)/CPU.py</Executable>
            <Param>GetUsage</Param>
        </Collector>
        
        <Collector ID="cpu.load1">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>LoadAverage1</Param>
        </Collector>
        
        <Collector ID="cpu.load5">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>LoadAverage5</Param>
        </Collector>
        
        <!-- Memory Metrics -->
        <Collector ID="memory.used">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>MemoryUsed</Param>
        </Collector>
        
        <Collector ID="memory.percent">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>MemoryPercent</Param>
        </Collector>
        
        <Collector ID="memory.available">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>MemoryAvailable</Param>
        </Collector>
        
        <!-- Network Metrics -->
        <Collector ID="network.eth0.rx">
            <Executable>$(CollectorsPath)/LinuxNetwork.py</Executable>
            <Param>$(NetworkInterface)</Param>
            <Param>rx_bytes</Param>
        </Collector>
        
        <Collector ID="network.eth0.tx">
            <Executable>$(CollectorsPath)/LinuxNetwork.py</Executable>
            <Param>$(NetworkInterface)</Param>
            <Param>tx_bytes</Param>
        </Collector>
        
        <!-- Disk Metrics -->
        <Collector ID="disk.root.used">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>DiskUsedPercent</Param>
            <Param>/</Param>
        </Collector>
        
        <Collector ID="disk.home.used">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>DiskUsedPercent</Param>
            <Param>/home</Param>
        </Collector>
        
        <!-- System Info -->
        <Collector ID="system.hostname">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>Hostname</Param>
        </Collector>
        
        <Collector ID="system.uptime">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>Uptime</Param>
        </Collector>
        
        <Collector ID="system.temperature">
            <Executable>$(CollectorsPath)/SystemInfo_Linux.py</Executable>
            <Param>CPUTemp</Param>
        </Collector>
        
        <!-- Service Control Actors -->
        <Actor ID="restart_service">
            <Executable>systemctl restart myapp</Executable>
        </Actor>
        
        <Actor ID="clear_cache">
            <Executable>rm -rf /var/cache/myapp/*</Executable>
        </Actor>
        
        <TargetConnection IP="$(OscarIP)" PORT="$(OscarPort)"/>
    </Namespace>
</Minion>
