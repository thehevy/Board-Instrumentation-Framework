{
  "default": true,
  "MD013": {
    "line_length": 120,
    "code_blocks": false,
    "tables": false
  },
  "MD024": {
    "siblings_only": true
  },
  "MD033": {
    "allowed_elements": [
      "details",
      "summary",
      "br",
      "wbr",
      "sup",
      "sub",
      "code",
      "pre",
      "a",
      "strong",
      "em",
      "span",
      "div"
    ]
  },
  "MD041": false,
  "MD060": {
    "style": "compact"
  },
  "table-column-style": {
    "style": "compact"
  }
}
