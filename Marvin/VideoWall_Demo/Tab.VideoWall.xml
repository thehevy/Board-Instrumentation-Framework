<MarvinExternalFile>
    <Tab>
        <Title>$(TabTitle)</Title>
        <Grid row="1" column="1" Align="Center">
            <!-- The VideoWall fills the tab; Height/Width are required so the
                 grid of video surfaces gets a concrete size to render into. -->
            <Widget File="$(AppDir)\VideoWall.8Stream.xml" row="1" column="1"
                    Align="Center" Height="840" Width="1580"/>
        </Grid>
    </Tab>
</MarvinExternalFile>
