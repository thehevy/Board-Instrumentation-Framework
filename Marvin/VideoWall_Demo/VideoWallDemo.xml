##############################################################################
#    File Abstract:
#    Marvin application that displays an 8-screen VideoWall using the default
#    settings from the original nuc_video_wall.py reference script.
#
#    Run from the Marvin directory (the one containing BIFF.Marvin.jar):
#        java -jar build\libs\BIFF.Marvin.jar -i VideoWall_Demo\VideoWallDemo.xml
#
#    Prerequisite: VLC (libVLC) must be installed on this host.
#    Streams expected on UDP ports 5000..5007 (udp://@0.0.0.0:500N).
##############################################################################
-->
    <Application Scale="auto" mode="debugg"> <!-- debug or kiosk -->
        <CreationSize Width="1600" Height="900"/>
        <Network Port="5200"/>
        <Title>Intel E835 RDMA LAG Demo - NUC Video Wall</Title>
        <Padding top="2" bottom="2" right="2" left="5"/>
        <StyleSheet>Widget/Modena-BIFF.css</StyleSheet>
        <Heartbeat Rate="10"/>

        <Tasks Enabled="True"/>
        <MainMenu Show="True"></MainMenu>

        <Tabs>
            <Tab ID="Tab.VideoWall" />
        </Tabs>
    </Application>

    <Tab ID="Tab.VideoWall" hgap="5" vgap="5" Align="N"
         TabTitle="Intel E835 RDMA LAG Demo - NUC Video Wall"
         File="$(AppDir)\Tab.VideoWall.xml"/>

    <AliasList>
        <Alias AppDir = "VideoWall_Demo"/>
    </AliasList>
</Marvin>
