##############################################################################
#    File Abstract:
#    Example VideoWall widget definition.
#
#    Displays multiple network video streams (UDP/RTP/HLS/HTTP/file) in an
#    automatically laid-out grid, using the native libVLC engine via vlcj.
#
#    Requirements:
#      - VLC media player (libVLC) MUST be installed on the host running Marvin.
#      - Up to 16 <Stream> entries are supported.
#
#    Optional settings:
#      <Columns>       - fixed number of columns; omit or 0 for auto (ceil(sqrt(n)))
#      <NetworkCaching> - VLC network caching in ms (raise to reduce jitter)
#      <Gap>            - pixel gap between cells
#      <ShowTitles>     - True/False, overlay a per-stream title label
#
#    Each <Stream> may carry an optional Title="..." attribute.
##############################################################################
-->
<Widget Type = "VideoWall">
    <Columns>2</Columns>
    <NetworkCaching>300</NetworkCaching>
    <Gap>6</Gap>
    <ShowTitles>True</ShowTitles>

    <Stream Title="LAG 1">udp://@0.0.0.0:5000</Stream>
    <Stream Title="LAG 2">udp://@0.0.0.0:5001</Stream>
    <Stream Title="LAG 3">udp://@0.0.0.0:5002</Stream>
    <Stream Title="LAG 4">udp://@0.0.0.0:5003</Stream>
</Widget>
